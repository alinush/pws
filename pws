#!/bin/bash

# pws - Move files and directories to a timestamped folder in ~/PWS

set -e

# Check if at least one argument is provided
if [ $# -eq 0 ]; then
    echo "Usage: pws <file1> [file2] [dir1] ..." >&2
    echo "Moves files and directories to a timestamped folder in ~/PWS" >&2
    exit 1
fi

# Create ~/PWS if it doesn't exist
PWS_BASE="$HOME/PWS"
mkdir -p "$PWS_BASE"

# Generate timestamped folder name
# Get all date components at once to avoid race conditions at date boundaries
DATE_INFO=$(date '+%Y %m %b %d %a %H %M %S')
read YEAR MONTH_NUM MONTH_NAME DAY_NUM DAY_NAME HOUR MIN SEC <<< "$DATE_INFO"
# Format: YYYY-MM-mon-DD-dy-HHh-MMm-SSs (e.g., 2026-02-feb-13-fr-08h-15m-30s)
MONTH_LOWER=$(echo "$MONTH_NAME" | tr '[:upper:]' '[:lower:]')
DAY_SHORT=$(echo "$DAY_NAME" | tr '[:upper:]' '[:lower:]' | cut -c1-2)
TIMESTAMP="$YEAR-$MONTH_NUM-$MONTH_LOWER-$DAY_NUM-$DAY_SHORT-${HOUR}h-${MIN}m-${SEC}s"
TARGET_DIR="$PWS_BASE/$TIMESTAMP"

# Create the timestamped directory (fail if it already exists)
if [ -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' already exists" >&2
    exit 1
fi
mkdir "$TARGET_DIR"

# Move all arguments to the target directory
for item in "$@"; do
    if [ -e "$item" ]; then
        mv "$item" "$TARGET_DIR/"
        #echo "Moved: $item -> $TARGET_DIR/"
    else
        echo "WARNING: '$item' does not exist. Skipping it..." >&2
    fi
done

echo "Files and directories moved to:"
echo "$TARGET_DIR"
